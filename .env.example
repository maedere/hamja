# ===================================================
# Hamja Supabase Configuration (Optional for Cloud DB)
# ===================================================
# If these environment variables are provided in .env.local,
# Hamja automatically switches from the local server database
# to your Supabase PostgreSQL cloud database.
#
# Get these from: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: Service Role Key for server-side administrative access
SUPABASE_SERVICE_ROLE_KEY=
